// Working dev config: filesystem reference server over the frozen sandbox +
// the public Hugging Face MCP. GitHub and the "bad" server join by M4.
{
  "project": "toolc-dev",
  "downstream": [
    {
      "id": "fs",
      "transport": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "./sandbox"]
      }
    },
    {
      "id": "hf",
      "transport": { "type": "http", "url": "https://huggingface.co/mcp" }
    },
    {
      "id": "github",
      "transport": {
        "type": "http",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": { "Authorization": "Bearer ${GITHUB_TOKEN}" }
      }
    },
    {
      // Overlap-rich bench additions (2026-08-23): weather overlaps nws,
      // article search overlaps gh/hf search. Both keyless, composed via
      // the openapi frontend (dogfooding REST composition in the bench).
      "id": "meteo",
      "transport": { "type": "openapi", "spec": "packages/openapi-autogen/specs/open-meteo.json" }
    },
    {
      "id": "hn",
      "transport": { "type": "openapi", "spec": "packages/openapi-autogen/specs/hn-algolia.json" }
    },
    {
      // The "bad" server (spec §8): naive OpenAPI auto-generation over the
      // National Weather Service API. Deliberately not hand-tuned.
      "id": "nws",
      "transport": {
        "type": "stdio",
        "command": "node",
        "args": [
          "packages/openapi-autogen/src/server.mjs",
          "packages/openapi-autogen/specs/nws.json"
        ]
      }
    }
  ],
  "compile": {
    // Benchmark runs auto-apply rewrites (hosted-style); review the diffs in
    // .toolc/compile-report.md instead of gating on per-entry approval.
    "rewrite": { "reviewMode": false }
  },
  "serve": {
    "mode": "mirror",
    "transport": "stdio",
    "logDb": ".toolc/calls.db"
  }
}
